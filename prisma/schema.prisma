generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_ESCROW
  ESCROW_LOCKED
  MATERIAL_UPLOADED
  PRODUCTION_VIDEO_ADDED
  DISPATCHED
  COMPLETED
  DISPUTED
  REFUNDED
}

enum ProofUploader {
  SUPPLIER
  BUYER
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND
  RESOLVED_RELEASE
}

enum DisputeReason {
  QUALITY
  DEFECT
  WRONG_QUANTITY
  WRONG_MATERIAL
  LATE_DELIVERY
  DAMAGE
  OTHER
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  ON_HOLD
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum OrderEventType {
  ORDER_CREATED
  PAYMENT_LOCKED
  PROOF_UPLOADED
  DISPATCHED
  INSPECTION_STARTED
  BUYER_RELEASED
  DISPUTE_OPENED
  REFUND_REQUESTED
  REFUND_COMPLETED
  PAYOUT_REQUESTED
  PAYOUT_COMPLETED
  ADMIN_RESOLUTION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REVERIFY_REQUIRED
  SUSPENDED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  BLOCKED
}

enum PartyType {
  BUYER
  SUPPLIER
}

enum RFQStatus {
  DRAFT
  PENDING_REVIEW
  MATCHING
  QUOTING
  NEGOTIATION
  AWARDED
  ORDERED
  CLOSED
  CANCELLED
  FLAGGED
}

enum MatchStatus {
  INVITED
  VIEWED
  QUOTED
  DECLINED
  DISQUALIFIED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  SHORTLISTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum VerificationType {
  GST
  PAN
  CIN
  LLPIN
  BANK
  IDENTITY
  ADDRESS
  FACTORY
  CERTIFICATION
  CAPABILITY
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  VERIFY
  REJECT
  SUSPEND
  BLOCK
  UNBLOCK
  VIEW
  EXPORT
  LOGIN
  LOGOUT
  PAYMENT
  DISPUTE
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  role UserRole
  razorpayLinkedAccountId String?
  createdAt DateTime @default(now())
  buyerOrders Order[] @relation("BuyerOrders")
  supplierOrders Order[] @relation("SupplierOrders")
  proofs OrderMilestone[]
  disputes Dispute[]
  payouts Payout[]
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  amount Decimal @db.Decimal(15, 2)
  currency String @default("INR")
  status OrderStatus @default(PENDING_ESCROW)
  buyerId String
  supplierId String
  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id])
  supplier User @relation("SupplierOrders", fields: [supplierId], references: [id])
  inspectionDeadlineAt DateTime?
  escrowLockedAt DateTime?
  completedAt DateTime?
  disputedAt DateTime?
  refundedAt DateTime?
  razorpayOrderId String? @unique
  razorpayPaymentId String?
  bankReference String?
  milestones OrderMilestone[]
  disputes Dispute[]
  payments Payment[]
  ledgerEntries EscrowLedgerEntry[]
  events OrderEvent[]
  payout Payout?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@index([status, inspectionDeadlineAt])
}

model OrderMilestone {
  id String @id @default(cuid())
  orderId String
  stepName String
  fileUrl String
  uploadedBy ProofUploader
  uploadedByUserId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user User @relation(fields: [uploadedByUserId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId, stepName])
}

model Dispute {
  id String @id @default(cuid())
  orderId String
  raisedById String
  reason DisputeReason
  details String
  status DisputeStatus @default(OPEN)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy User @relation(fields: [raisedById], references: [id])
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([orderId, status])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  provider String @default("RAZORPAY")
  providerEventId String? @unique
  providerPaymentId String?
  amount Decimal @db.Decimal(15, 2)
  status PaymentStatus @default(PENDING)
  method String?
  rawPayload Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model EscrowLedgerEntry {
  id String @id @default(cuid())
  orderId String
  type String
  amount Decimal @db.Decimal(15, 2)
  referenceId String?
  metadata Json?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderEvent {
  id String @id @default(cuid())
  orderId String
  type OrderEventType
  actorUserId String?
  referenceId String?
  metadata Json?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model WebhookEvent {
  id String @id @default(cuid())
  eventId String @unique
  eventType String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  payload Json

  @@index([eventType, receivedAt])
}

model Payout {
  id String @id @default(cuid())
  orderId String @unique
  supplierId String
  amount Decimal @db.Decimal(15, 2)
  status PayoutStatus @default(PENDING)
  providerRef String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id])
  supplier User @relation(fields: [supplierId], references: [id])
}

// Industrial Connect trust and procurement domain.
// These models are intentionally separated from payment-provider data so regulated
// payment custody remains with the configured payment provider/financial partner.
model Organization {
  id String @id @default(cuid())
  legalName String
  tradeName String?
  gstin String? @unique
  pan String?
  cin String?
  llpin String?
  emailDomain String?
  phone String?
  registeredAddress String?
  factoryAddress String?
  partyType PartyType
  verificationStatus VerificationStatus @default(UNVERIFIED)
  riskLevel RiskLevel @default(MEDIUM)
  trustScore Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([partyType, verificationStatus])
  @@index([riskLevel, trustScore])
}

model VerificationCase {
  id String @id @default(cuid())
  organizationId String
  type VerificationType
  status VerificationStatus @default(PENDING)
  provider String?
  referenceHash String?
  documentUrl String?
  reviewedBy String?
  reason String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, type])
  @@index([status, expiresAt])
}

model RiskSignal {
  id String @id @default(cuid())
  organizationId String?
  userId String?
  orderId String?
  code String
  severity RiskLevel
  score Int
  description String
  evidence Json?
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([organizationId, resolved, severity])
  @@index([orderId, resolved])
}

model Capability {
  id String @id @default(cuid())
  name String @unique
  category String
  description String?
  createdAt DateTime @default(now())
}

model SupplierCapability {
  id String @id @default(cuid())
  supplierOrganizationId String
  capabilityId String
  proficiency Int @default(50)
  verified Boolean @default(false)
  evidenceUrl String?
  createdAt DateTime @default(now())
  @@unique([supplierOrganizationId, capabilityId])
  @@index([capabilityId, verified, proficiency])
}

model Machine {
  id String @id @default(cuid())
  supplierOrganizationId String
  machineType String
  make String?
  model String?
  serialHash String?
  capacityDescription String?
  status String @default("ACTIVE")
  utilizationPercent Int @default(0)
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([supplierOrganizationId, status])
}

model Certification {
  id String @id @default(cuid())
  supplierOrganizationId String
  name String
  issuer String?
  certificateNumberHash String?
  documentUrl String?
  status VerificationStatus @default(PENDING)
  issuedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  @@index([supplierOrganizationId, status, expiresAt])
}

model TrustScore {
  id String @id @default(cuid())
  organizationId String @unique
  verificationScore Int @default(0)
  qualityScore Int @default(0)
  deliveryScore Int @default(0)
  quoteAccuracyScore Int @default(0)
  capacityScore Int @default(0)
  disputeScore Int @default(0)
  documentationScore Int @default(0)
  buyerReliabilityScore Int @default(0)
  overallScore Int @default(0)
  calculatedAt DateTime @default(now())
  @@index([overallScore])
}

model RFQ {
  id String @id @default(cuid())
  rfqNumber String @unique
  buyerOrganizationId String
  title String
  category String
  quantity Decimal @db.Decimal(18, 3)
  unit String
  deliveryCity String
  deliveryDeadline DateTime?
  quoteDeadline DateTime?
  technicalNotes String?
  specificationHash String?
  qualityRequirements String?
  rfqQualityScore Int @default(0)
  riskLevel RiskLevel @default(LOW)
  status RFQStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([buyerOrganizationId, status])
  @@index([category, deliveryCity, status])
}

model RFQItem {
  id String @id @default(cuid())
  rfqId String
  name String
  material String?
  tolerance String?
  finish String?
  drawingUrl String?
  quantity Decimal @db.Decimal(18, 3)
  unit String
  createdAt DateTime @default(now())
  @@index([rfqId])
}

model SupplierMatch {
  id String @id @default(cuid())
  rfqId String
  supplierOrganizationId String
  capabilityFit Int
  capacityFit Int
  locationFit Int
  qualityFit Int
  deliveryFit Int
  riskPenalty Int @default(0)
  matchScore Int
  status MatchStatus @default(INVITED)
  createdAt DateTime @default(now())
  @@unique([rfqId, supplierOrganizationId])
  @@index([rfqId, matchScore])
}

model Quote {
  id String @id @default(cuid())
  rfqId String
  supplierOrganizationId String
  totalAmount Decimal @db.Decimal(18, 2)
  unitPrice Decimal @db.Decimal(18, 4)
  leadTimeDays Int
  paymentTerms String?
  validityDate DateTime?
  notes String?
  status QuoteStatus @default(SUBMITTED)
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([rfqId, status])
  @@index([supplierOrganizationId, submittedAt])
}

model PurchaseOrder {
  id String @id @default(cuid())
  orderId String?
  rfqId String?
  poNumber String @unique
  buyerOrganizationId String
  supplierOrganizationId String
  amount Decimal @db.Decimal(18, 2)
  termsHash String
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@index([buyerOrganizationId, createdAt])
  @@index([supplierOrganizationId, createdAt])
}

model TransactionPassport {
  id String @id @default(cuid())
  orderId String @unique
  rfqId String?
  buyerOrganizationId String
  supplierOrganizationId String
  state String
  specificationHash String?
  contractHash String?
  commissionAmount Decimal? @db.Decimal(18, 2)
  protectedValue Decimal? @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionMilestone {
  id String @id @default(cuid())
  orderId String
  stage String
  percentComplete Int @default(0)
  evidenceUrl String?
  evidenceHash String?
  note String?
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}

model Inspection {
  id String @id @default(cuid())
  orderId String
  inspectorOrganizationId String?
  type String
  status String @default("PENDING")
  checklist Json?
  reportUrl String?
  evidenceHash String?
  result String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([orderId, status])
}

model Shipment {
  id String @id @default(cuid())
  orderId String
  transporter String?
  trackingNumber String?
  lrNumber String?
  status String @default("PENDING")
  eta DateTime?
  podUrl String?
  podHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, status])
}

model Commission {
  id String @id @default(cuid())
  orderId String
  grossAmount Decimal @db.Decimal(18, 2)
  rate Decimal @db.Decimal(6, 3)
  amount Decimal @db.Decimal(18, 2)
  status String @default("PENDING")
  referenceId String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  @@index([status, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  organizationId String?
  orderId String?
  rfqId String?
  action AuditAction
  entityType String
  entityId String
  before Json?
  after Json?
  ipHash String?
  userAgentHash String?
  requestId String?
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
}

model ContactProtectionEvent {
  id String @id @default(cuid())
  rfqId String?
  orderId String?
  buyerOrganizationId String?
  supplierOrganizationId String?
  eventType String
  riskLevel RiskLevel
  masked Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
  @@index([riskLevel, createdAt])
}
